; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Deadline Hero"
config/description="60초 안에 세계를 구하는 루프형 픽셀 JRPG"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/icon.png"
boot_splash/bg_color=Color(0.18, 0.13, 0.18, 1)
boot_splash/show_image=false

[autoload]

Game="*res://scripts/autoload/game.gd"
Audio="*res://scripts/autoload/audio.gd"
DB="*res://scripts/autoload/db.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[gui]

theme/custom_font="res://assets/fonts/Galmuri11.ttf"
theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=0.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.18, 0.13, 0.18, 1)
2d/snap/snap_2d_vertices_to_pixel=true
